# Hosting recipe env — copy to deploy/.env and fill in (deploy/.env is gitignored).
#
#   cp deploy/.env.example deploy/.env
#   # edit DOMAIN + CONFIG_DIR
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build

# Public hostname buyer agents connect to. Caddy fetches a real TLS cert for it automatically.
# This DNS name must already point at this server's public IP (A/AAAA record).
DOMAIN=seller-mcp.yourpublisher.com

# Path to your REAL operator config directory (host path, mounted read-only into the node):
# deployment.json, catalog.json, entitlements.json, pricing.json, and optionally forecast.json.
CONFIG_DIR=./config

# Audit head-hash anchor backend: "file" (local, dev), "tsa" (RFC 3161 timestamp authority),
# or "s3" (S3 Object Lock). Use "tsa" or "s3" for third-party tamper-evidence in a real pilot.
# tsa/s3 need their own vars — see docs/PUBLISHER-DEPLOYMENT.md.
MCP_ANCHOR_SINK=tsa
